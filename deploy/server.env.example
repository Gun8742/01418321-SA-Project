# Copy to .env.server at repository root. Use random URL-safe secrets.
POSTGRES_PASSWORD=replace-with-random-url-safe-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://workforce.your-organization.example
# Existing private S3 bucket with credentials limited to this bucket. No S3Mock.
S3_REGION=ap-southeast-1
S3_BUCKET=replace-private-bucket
S3_ACCESS_KEY_ID=replace-key
S3_SECRET_ACCESS_KEY=replace-secret
# S3_ENDPOINT=https://your-s3-compatible-storage.example
SMTP_HOST=smtp.your-organization.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-user
SMTP_PASSWORD=replace-password
MAIL_FROM=SA Workforce <workforce@your-organization.example>
