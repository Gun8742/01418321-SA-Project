# Local development infrastructure. Copy to .env and replace secrets.
BACKEND_ENABLED=true
NEXT_PUBLIC_ENABLE_MOCK=false
POSTGRES_PASSWORD=replace-local-db-password
DATABASE_URL=postgresql://sa:replace-local-db-password@127.0.0.1:5447/sa_local
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
S3_ENDPOINT=http://127.0.0.1:9040
S3_REGION=us-east-1
S3_BUCKET=sa-local
S3_ACCESS_KEY_ID=local-test
S3_SECRET_ACCESS_KEY=local-test
CASE_POLICY_VERSION=INTERNAL-1
EXTERNAL_RESULTS_BY_EMPLOYER=true
ALLOW_SYNTHETIC_POLICY=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=SA Workforce <workforce@example.test>
# SMTP_USER=
# SMTP_PASSWORD=
# Required by the explicit local account provisioning command. Never use real passwords.
SEED_PASSWORD=replace-with-a-long-local-test-password
