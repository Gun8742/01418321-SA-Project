{
  "name": "sa-workforce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:specs": "python3 scripts/check-specs.py",
    "format": "prettier --write src tests scripts/*.ts prisma/seed.ts *.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src tests scripts/*.ts prisma/seed.ts *.config.ts tsconfig.json package.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts",
    "test:integration": "node --conditions=react-server --import tsx scripts/test-backend.ts",
    "db:grant": "node --conditions=react-server --import tsx scripts/grant-capability.ts",
    "storage:cleanup": "node --conditions=react-server --import tsx scripts/cleanup-uploads.ts",
    "test:e2e:backend": "playwright test --config playwright.backend.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.10",
    "dotenv": "18.0.8",
    "next": "16.4.2",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "type": "module"
}
