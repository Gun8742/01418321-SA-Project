{
  "name": "sa-workforce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:specs": "python3 scripts/check-specs.py",
    "format": "prettier --write src tests next.config.ts playwright.config.ts vitest.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src tests next.config.ts playwright.config.ts vitest.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "type": "module"
}
